# Copy this file to .env and fill in real values. .env is gitignored.

# Your Supabase project's BARE URL — e.g. https://abcdefgh.supabase.co
# Project Settings → Data API → Project URL.
# Do NOT paste the REST endpoint (the one ending in /rest/v1/): supabase-js
# appends that itself, and leaving it on makes every query 404.
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → Data API → anon / public key. Safe to expose to the
# browser; the app's authorization happens server-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → Data API → service_role / secret key. Bypasses row
# security — treat it like a password and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter API key, from https://openrouter.ai/keys. Used by
# model/recipe.js for AI recipe generation, which runs on free models
# (see RECIPE_MODELS below) so a zero-balance account works — subject to a
# daily cap that a small amount of credit raises.
OPENROUTER_API_KEY=

# Optional. Comma-separated OpenRouter model ids, tried in order until one
# returns a schema-valid recipe. Defaults to a non-reasoning pair; see the
# comment in model/recipe.js for why reasoning models are unsuitable here.
# RECIPE_MODELS=liquid/lfm-2.5-2.6b:free,openrouter/free
